# ==============================================================================
# REQUIRED & AI SERVICES
# ==============================================================================

# GEMINI_API_KEY: Required for Google Gemini AI features and assistant logic.
# Automatically injected if configured in the AI Studio Settings / Secrets panel.
GEMINI_API_KEY=

# GROQ_API_KEY: Optional high-speed LLM inference key for Raynai AI Bot & game master.
GROQ_API_KEY=

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================

# JWT_SECRET: Secret key used to sign and verify user authentication tokens.
# A default fallback is used in development if not specified.
JWT_SECRET=

# ==============================================================================
# DATABASE (OPTIONAL / TURSO CLOUD)
# ==============================================================================

# TURSO_DATABASE_URL: Optional remote Turso/LibSQL database URL (e.g., libsql://your-db.turso.io).
# If omitted, the app uses a local SQLite database (local.db).
TURSO_DATABASE_URL=

# TURSO_AUTH_TOKEN: Authentication token for Turso cloud database (if using TURSO_DATABASE_URL).
TURSO_AUTH_TOKEN=

# ==============================================================================
# PLATFORM & HOSTING
# ==============================================================================

# APP_URL: The URL where this applet is hosted (auto-injected in production/Cloud Run).
APP_URL=

