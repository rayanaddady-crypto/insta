{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|uploads|socket.io|assets|favicon|icon|manifest|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
