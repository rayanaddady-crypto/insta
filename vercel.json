{
  "version": 2,
  "buildCommand": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/_server.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|uploads|socket.io|assets|favicon|icon|manifest|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
